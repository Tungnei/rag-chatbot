# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables
.env
.env.local

# Runtime data
/data/embeddings/*
!/data/embeddings/.gitkeep
/data/uploads/
/notebooks/.ipynb_checkpoints

# Local-only compose overrides (machine-specific paths, CA bundles)
docker-compose.override.yml
docker-compose.override.yaml

# Harness runtime state: per-machine trace telemetry, not project content.
.harness/state/
# Lock file held while the backlog SSOT is written.
docs/.backlog_register.lock
# Migration snapshots record one machine's index at one moment; the script writes them
# and reads them back on resume. They are operational state, not source.
/data/eval/migration-snapshot-*.json
/data/eval/migration-in-progress.json
