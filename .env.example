# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Qdrant (nested settings use double underscore)
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=documents

# Only when the Qdrant server actually requires auth — Qdrant Cloud, or a self-hosted
# instance started with QDRANT__SERVICE__API_KEY set on the server side. Leave the line
# commented out for the local docker compose setup, which runs without auth: an empty
# value is not the same as unset, and makes the client warn about sending a key over
# an insecure connection. Use https:// if you do set one, or it travels in cleartext.
# QDRANT__API_KEY=

# LLM
LLM__MODEL=gpt-4o-mini
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=2000

# Embeddings
EMBEDDINGS__MODEL=text-embedding-3-small

# Retriever
RETRIEVER__TOP_K=3
RETRIEVER__SCORE_THRESHOLD=0.3

# API
API__HOST=0.0.0.0
API__PORT=8000

LOG_LEVEL=INFO
