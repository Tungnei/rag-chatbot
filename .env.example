# Keys. The embedding half of the pipeline is always OpenAI (Anthropic has no
# embeddings API), so OPENAI_API_KEY is required whichever LLM provider you pick.
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Qdrant (nested settings use double underscore)
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=documents

# Only when the Qdrant server actually requires auth — Qdrant Cloud, or a self-hosted
# instance started with QDRANT__SERVICE__API_KEY set on the server side. Leave the line
# commented out for the local docker compose setup, which runs without auth: an empty
# value is not the same as unset, and makes the client warn about sending a key over
# an insecure connection. Use https:// if you do set one, or it travels in cleartext.
# QDRANT__API_KEY=

# LLM — switching provider is these two lines and nothing else.
#
#   OpenAI:     LLM__PROVIDER=openai     LLM__MODEL=gpt-4o-mini
#   Anthropic:  LLM__PROVIDER=anthropic  LLM__MODEL=claude-opus-5
#
LLM__PROVIDER=openai
LLM__MODEL=gpt-4o-mini
# Point at a gateway that speaks the selected provider's protocol; empty = the
# provider's own endpoint. A local proxy serving the Messages API, for example:
#   LLM__PROVIDER=anthropic
#   LLM__BASE_URL=http://localhost:8317
#   LLM__MODEL=claude-opus-5
# LLM__BASE_URL=
# OpenAI only. Current Claude models reject temperature with a 400; the Anthropic
# adapter drops it, so this line is simply ignored when the provider is anthropic.
LLM__TEMPERATURE=0.7
# On Claude models that think, this covers thinking AND the answer. 2000 is fine for
# gpt-4o-mini; give Claude more headroom (8000+) or answers can be cut off mid-sentence.
LLM__MAX_TOKENS=2000
# Anthropic only: low | medium | high | xhigh | max. Controls how much the model thinks.
# Not accepted by every Claude model — leave it unset unless you know yours takes it.
# LLM__EFFORT=low

# Embeddings — always OpenAI, and always 1536 dimensions to match QDRANT__VECTOR_SIZE.
# Changing the embedding model means rebuilding the collection from scratch.
EMBEDDINGS__PROVIDER=openai
EMBEDDINGS__MODEL=text-embedding-3-small
# EMBEDDINGS__BASE_URL=
# Note: a Claude gateway does not make OPENAI_API_KEY optional. Gateways that serve
# the Messages API typically serve chat only — check for /v1/embeddings before
# assuming one key covers both halves of the pipeline.

# Retriever
RETRIEVER__TOP_K=3
RETRIEVER__SCORE_THRESHOLD=0.3

# API
API__HOST=0.0.0.0
API__PORT=8000

LOG_LEVEL=INFO
